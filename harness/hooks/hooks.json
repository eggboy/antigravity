{
  "stop-bell": {
    "Stop": [
      {
        "type": "command",
        "command": "{ printf '\\a' >/dev/tty; } 2>/dev/null; if command -v afplay >/dev/null 2>&1; then (afplay -v 1.0 /System/Library/Sounds/Glass.aiff >/dev/null 2>&1 &) ; else tput bel >/dev/tty; fi; echo '{}'",
        "timeout": 10
      }
    ]
  },
  "question-bell": {
    "PreToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "{ printf '\\a' >/dev/tty; } 2>/dev/null; echo '{\"decision\":\"allow\"}'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "lint-enforcer": {
    "Stop": [
      {
        "type": "command",
        "command": "bash /Users/jayleeg/Develop/git/antigravity/harness/hooks/lint-enforcer/lint-enforcer.sh",
        "timeout": 300
      }
    ]
  }
}
